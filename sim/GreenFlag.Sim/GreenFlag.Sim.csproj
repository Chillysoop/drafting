<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sim source lives once, in the Unity package. This project compiles the same files for CI. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>GreenFlag.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../game/Packages/com.greenflag.sim/Runtime/**/*.cs" LinkBase="Runtime" />
  </ItemGroup>
</Project>
